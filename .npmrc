# Where packages come from, said out loud.
#
# npm resolves its registry from a chain of places — a user ~/.npmrc, an
# environment variable, a shell that was configured for some other project —
# and a package installed from the wrong one is indistinguishable afterwards
# from the right one. Pinning it here means an install in this repository
# reaches the public registry or fails, rather than quietly reaching whatever
# the machine was last pointed at.
registry=https://registry.npmjs.org/

# Installs come from package-lock.json. `npm install` writing a newer version
# into the tree than the lockfile records is how a reviewed dependency set
# stops matching what actually runs; CI and the deploy both use `npm ci`,
# which refuses when the two disagree, and this keeps a local install honest
# in the same way.
package-lock=true

# Neither of these is a security control — they are noise removal, so a real
# warning in an install log is legible.
fund=false

# `npm audit` at install time has nothing to say about a build that is already
# pinned by a lockfile, and its exit code failing an install is a deploy that
# stops for a transitive advisory nobody has read yet. Audits belong in a step
# that a person reads: `npm audit --audit-level=high`.
audit=false
