# Copy to .env at the repo root: `cp .env.docker.example .env`
# docker compose reads this file automatically.

# ---- Ports -------------------------------------------------------------
WEB_PORT=8080
API_PORT=4001
POSTGRES_PORT=5432

# ---- Auth --------------------------------------------------------------
# Leave blank: `npm run docker:up` generates one on first run and never
# overwrites a value you have set yourself.
JWT_SECRET=
JWT_ISSUER=accounting
JWT_AUDIENCE=accounting-web
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ---- Branding & links --------------------------------------------------
# Base URL used in password-reset and email-verification links. Must be the
# address users actually browse to — the server's own fallback is the Vite dev
# port (5173), which nothing serves under Docker.
APP_NAME=Accounting
APP_URL=http://localhost:8080

# ---- Email -------------------------------------------------------------
# Encrypts saved SMTP passwords. Generated on first run when left blank.
# Deliberately separate from JWT_SECRET: if they were shared, rotating the JWT
# secret would make every stored SMTP password undecryptable.
MAIL_SECRET_KEY=

# Platform-wide fallback SMTP. Leave blank to rely on per-org SMTP configured
# in Settings → Email, or the capture transport when no org has any.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# ---- Database ----------------------------------------------------------
# SQLite (default, matches the current Prisma schema):
DATABASE_URL=file:/data/dev.db

# Postgres (`docker compose --profile postgres up`) — also switch the Prisma
# datasource provider to "postgresql" and fix the SQLite `?` placeholders in
# server/src/routes/invoices.ts first. See docs/REVIEW.md gap D-1.
# DATABASE_URL=postgresql://accounting:CHANGE_ME@db:5432/accounting?schema=public
POSTGRES_USER=accounting
# Also generated on first run when left blank.
POSTGRES_PASSWORD=
POSTGRES_DB=accounting

# ---- Frontend ----------------------------------------------------------
# Leave empty so the SPA uses same-origin /api through nginx.
VITE_API_BASE=
# Only used when the API is called from a different origin than the web app.
CORS_ORIGIN=http://localhost:8080
