# Database (local/dev)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-me"
JWT_ISSUER="accounting"
JWT_AUDIENCE="accounting-web"
JWT_EXPIRES_IN="8h"

# Server
PORT=4001
CORS_ORIGIN="http://127.0.0.1:5173"

# Security
BCRYPT_ROUNDS=12

# GSTIN lookup ("Fetch" on the vendor form).
# Point this at your GST Suvidha Provider — {gstin} is substituted, or the
# GSTIN is appended. Left unset, Fetch still fills the state and PAN that the
# GSTIN itself encodes and says the portal lookup is not configured.
GSTIN_LOOKUP_URL=""
GSTIN_LOOKUP_KEY=""
GSTIN_LOOKUP_KEY_HEADER="Authorization"
