# Database (local/dev)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-me"
JWT_ISSUER="accounting"
JWT_AUDIENCE="accounting-web"
JWT_EXPIRES_IN="8h"

# Server
PORT=4001
CORS_ORIGIN="http://127.0.0.1:5173"

# Security
BCRYPT_ROUNDS=12

# GSTIN lookup — the "Fetch from GSTN" button on the company, customer and
# vendor forms.
#
# Point the URL at your GST Suvidha Provider. `{gstin}` is substituted where it
# appears; with no placeholder the GSTIN is appended to the path. The key is
# sent in whichever header the provider wants — Authorization by default, but
# many use x-api-key.
#
#   GSTIN_LOOKUP_URL="https://api.provider.com/v1/gstin/{gstin}"
#   GSTIN_LOOKUP_KEY="Bearer sk_live_..."      # or just the raw key
#   GSTIN_LOOKUP_KEY_HEADER="x-api-key"
#
# Left unset the button still works: the state and the PAN are read out of the
# GSTIN itself, which is most of what it is for. What the portal adds on top is
# the legal name, the trade name and the registered address.
#
# The response is mapped from the GSTN field names (lgnm, tradeNam, pradr.addr)
# and the common provider aliases, so most providers need no code change. The
# answer is cached for ten minutes per GSTIN, because these are billed per call
# and a person correcting a typo presses the button repeatedly.
GSTIN_LOOKUP_URL=""
GSTIN_LOOKUP_KEY=""
GSTIN_LOOKUP_KEY_HEADER="Authorization"

# Payroll keeps its own database, separate from the accounting one. Salaries,
# bank accounts and PANs live here and nowhere else, so this file can be backed
# up, retained and restored on its own schedule. Payroll still posts into the
# accounting ledger through the API, never by writing to that database.
PAYROLL_DATABASE_URL="file:./payroll.db"

# Who works here. One person record, shared by payroll and by attendance,
# timesheets and leave when they arrive — owned by none of them. Kept apart from
# both accounting and payroll so a staff directory is not a place to read a
# bank account.
PEOPLE_DATABASE_URL="file:./people.db"
