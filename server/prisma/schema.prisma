generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------
// Core tenancy
// ----------------------------
model Account {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgs  Org[]
  users User[]
}

model Org {
  id              String   @id @default(cuid())
  accountId       String
  name            String
  legalName       String?
  pan             String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("OrgCreatedBy", fields: [createdByUserId], references: [id])

  branches Branch[]
  roles    Role[]
  members  UserOrgMembership[]
  audit    AuditLog[]

  @@unique([accountId, name])
  @@index([accountId])
}

model Branch {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  branchCode   String
  branchName   String
  addressLine1 String
  addressLine2 String?
  city         String?
  state        String
  country      String

  gstin               String?
  // SQLite-compatible: store enum as string (REGULAR | COMPOSITION | UNREGISTERED)
  gstRegistrationType String  @default("UNREGISTERED")
  phone               String?
  email               String?
  contactPerson       String?

  parentBranchId          String?
  shareHeadOfficeSettings Boolean @default(false)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Branch?  @relation("BranchParent", fields: [parentBranchId], references: [id])
  children Branch[] @relation("BranchParent")

  createdBy User @relation("BranchCreatedBy", fields: [createdByUserId], references: [id])

  users      UserBranchMembership[]
  warehouses Warehouse[]

  transfersOut InterBranchTransfer[] @relation("TransferSource")
  transfersIn  InterBranchTransfer[] @relation("TransferTarget")

  @@unique([orgId, branchCode])
  @@index([accountId, orgId])
}

// ----------------------------
// Warehouses
// ----------------------------
model Warehouse {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  name                String
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  country             String?
  gstin               String?
  gstRegistrationType String  @default("UNREGISTERED")
  contactPerson       String?
  phone               String?
  email               String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stock  StockBalance[]
  access UserWarehouseAccess[]

  transferLines InterBranchTransferLine[]

  transfersOut InterBranchTransfer[] @relation("WarehouseOut")
  transfersIn  InterBranchTransfer[] @relation("WarehouseIn")

  @@unique([orgId, branchId, name])
  @@index([accountId, orgId, branchId])
}

// ----------------------------
// Users + access
// ----------------------------
model User {
  id        String @id @default(cuid())
  accountId String

  username     String? // optional username login
  email        String // primary login
  fullName     String
  passwordHash String
  isActive     Boolean @default(true)

  // Lockout state. Cleared on a successful sign-in.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  orgMemberships    UserOrgMembership[]
  branchMemberships UserBranchMembership[]
  roleAssignments   UserRoleAssignment[]
  warehouseAccess   UserWarehouseAccess[]

  createdOrgs     Org[]    @relation("OrgCreatedBy")
  createdBranches Branch[] @relation("BranchCreatedBy")

  auditCreated AuditLog[] @relation("AuditCreatedBy")

  @@unique([accountId, email])
  @@index([accountId])
}

model UserOrgMembership {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  userId    String

  createdAt DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, userId])
  @@index([accountId, orgId])
}

model UserBranchMembership {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String
  userId    String

  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, userId])
  @@index([accountId, orgId, branchId])
}

model UserWarehouseAccess {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String
  userId      String

  createdAt DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, warehouseId, userId])
  @@index([accountId, orgId, branchId, warehouseId])
}

// ----------------------------
// Roles + permissions
// ----------------------------
model Role {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  // Optional: branch-scoped custom role
  branchId  String?

  name        String
  description String?
  // SQLite-compatible: store enum as string (ADMIN | ACCOUNTANT | SALES | CUSTOM)
  roleType    String

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([orgId, branchId, name])
  @@index([accountId, orgId])
}

model Permission {
  id        String  @id @default(cuid())
  module    String
  subModule String?
  // SQLite-compatible: store enum as string (VIEW | CREATE | EDIT | DELETE | APPROVE | EXPORT)
  action    String

  rolePermissions RolePermission[]

  @@unique([module, subModule, action])
}

model RolePermission {
  id           String  @id @default(cuid())
  accountId    String
  orgId        String
  roleId       String
  permissionId String
  allowed      Boolean @default(true)
  // Field-level access, as in ERPNext's permlevels. Level 0 covers ordinary
  // fields; a field declared at level 1 needs a rule granting level >= 1.
  permLevel    Int     @default(0)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([accountId, orgId])
}

// Role assignment per org and optionally per branch.
// If branchId is null => org-wide role.
model UserRoleAssignment {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  branchId  String?
  userId    String
  roleId    String

  createdByUserId String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, userId, roleId])
  @@index([accountId, orgId, branchId])
}

// ----------------------------
// Inventory + inter-branch transfer
// ----------------------------
model Item {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  // branchId allows branch-specific master overrides; for shared masters use null
  branchId  String?

  sku      String
  name     String
  unit     String
  isActive Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockBalances StockBalance[]
  transferLines InterBranchTransferLine[]

  @@unique([orgId, branchId, sku])
  @@index([accountId, orgId])
}

model StockBalance {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String
  itemId      String

  qtyOnHand Decimal @default(0)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([orgId, branchId, warehouseId, itemId])
  @@index([accountId, orgId, branchId, warehouseId])
}

model InterBranchTransfer {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  branchId          String // source context for isolation
  sourceBranchId    String
  sourceWarehouseId String
  targetBranchId    String
  targetWarehouseId String

  transferNo String
  status     String @default("DRAFT") // DRAFT | SENT | RECEIVED | REJECTED

  initiatedByUserId String
  approvedByUserId  String?
  rejectedReason    String?

  sentAt     DateTime?
  receivedAt DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceBranch    Branch    @relation("TransferSource", fields: [sourceBranchId], references: [id])
  targetBranch    Branch    @relation("TransferTarget", fields: [targetBranchId], references: [id])
  sourceWarehouse Warehouse @relation("WarehouseOut", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse @relation("WarehouseIn", fields: [targetWarehouseId], references: [id])

  lines InterBranchTransferLine[]

  @@unique([orgId, transferNo])
  @@index([accountId, orgId, sourceBranchId])
  @@index([accountId, orgId, targetBranchId])
}

model InterBranchTransferLine {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String

  transferId String
  itemId     String
  qty        Decimal

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transfer  InterBranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([accountId, orgId, transferId])
}

model InventoryAdjustment {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String
  itemId      String
  qtyDelta    Decimal
  reason      String

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId, branchId, warehouseId, itemId])
}

// ----------------------------
// Sales invoices
// ----------------------------
model Invoice {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  warehouseId String?
  number      String
  date        String
  dueDate     String?
  refNo       String?
  refDate     String?

  customerId         String?
  customerName       String
  customerGstin      String?
  placeOfSupplyState String?
  taxType            String?

  subtotal   Decimal @default(0)
  cgstTotal  Decimal @default(0)
  sgstTotal  Decimal @default(0)
  igstTotal  Decimal @default(0)
  gstTotal   Decimal @default(0)
  total      Decimal @default(0)
  paidAmount Decimal @default(0)

  status           String  @default("Draft")
  sourceEstimateId String?
  itemsJson        String

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, branchId, number])
  @@index([accountId, orgId, branchId, date])
}

// ----------------------------
// Audit log
// ----------------------------
model AuditLog {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  entity   String
  entityId String
  action   String
  message  String?
  // SQLite-compatible: store JSON metadata as string (optional)
  metadata String?

  createdByUserId String
  createdAt       DateTime @default(now())

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User @relation("AuditCreatedBy", fields: [createdByUserId], references: [id])

  @@index([accountId, orgId, branchId])
}

// ----------------------------
// General ledger (double-entry)
// ----------------------------
// Reports read POSTED JournalLine rows. Control accounts are resolved by
// controlKind, never by matching an account name.

model FiscalYear {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  name          String // "2026-27"
  startDate     String // ISO date
  endDate       String
  status        String  @default("OPEN") // OPEN | CLOSED
  lockedThrough String? // books locked up to and including this date

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries JournalEntry[]

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

model Journal {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  branchId  String?

  code String // SAL | PUR | BNK | CSH | JV | OPN
  name String
  type String // SALE | PURCHASE | BANK | CASH | GENERAL | OPENING

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries JournalEntry[]

  @@unique([orgId, branchId, code])
  @@index([accountId, orgId])
}

model LedgerAccount {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  branchId  String? // null = shared by every branch

  code        String
  name        String
  accountType String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  parentId    String?

  // Machine identity for control accounts. Postings look accounts up by this,
  // which is what makes renaming an account safe.
  controlKind String? // AR | AP | STOCK | SALES | PURCHASES | CGST_OUT |
  // SGST_OUT | IGST_OUT | CGST_IN | SGST_IN | IGST_IN |
  // CASH | BANK | ROUNDING | OPENING_DIFF | SUSPENSE
  isActive    Boolean @default(true)

  sourceSystem String?
  sourceKey    String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines JournalLine[]

  @@unique([orgId, branchId, code])
  @@unique([orgId, sourceSystem, sourceKey])
  @@index([accountId, orgId, controlKind])
}

model JournalEntry {
  id           String @id @default(cuid())
  accountId    String
  orgId        String
  branchId     String
  journalId    String
  fiscalYearId String

  entryNo   String
  date      String
  narration String?
  status    String  @default("DRAFT") // DRAFT | POSTED | REVERSED

  postedAt       DateTime?
  postedByUserId String?
  reversedById   String? // the entry that reverses this one

  sourceDocType String? // INVOICE | BILL | PAYMENT | RECEIPT | TRANSFER | OPENING
  sourceDocId   String?

  // Tamper-evidence: sha256(prevHash + canonical payload) per branch chain.
  prevHash String?
  hash     String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journal    Journal       @relation(fields: [journalId], references: [id])
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id])
  lines      JournalLine[]

  @@unique([orgId, branchId, entryNo])
  @@index([accountId, orgId, branchId, date])
  @@index([accountId, orgId, sourceDocType, sourceDocId])
  @@index([accountId, orgId, status])
}

model JournalLine {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String
  entryId   String

  ledgerAccountId String
  partyType       String? // CUSTOMER | VENDOR
  partyId         String?
  itemId          String?
  warehouseId     String?

  debit  Decimal @default(0)
  credit Decimal @default(0)

  taxCode     String?
  hsnSac      String?
  description String?

  createdAt DateTime @default(now())

  entry         JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([accountId, orgId, branchId, ledgerAccountId])
  @@index([accountId, orgId, partyType, partyId])
  @@index([entryId])
}

// ----------------------------
// Role profiles — bundles of roles, assigned as one unit
// ----------------------------
model RoleProfile {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  description String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles       RoleProfileRole[]
  assignments UserRoleProfile[]

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

model RoleProfileRole {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  profileId String
  roleId    String

  profile RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleId])
  @@index([accountId, orgId])
}

model UserRoleProfile {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  profileId String
  branchId  String?

  createdByUserId String
  createdAt       DateTime @default(now())

  profile RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, userId, profileId])
  @@index([accountId, orgId, userId])
}

// ----------------------------
// Approval thresholds
// ----------------------------
model ApprovalRule {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  branchId  String?

  docType   String // INVOICE | BILL | PAYMENT | JOURNAL
  name      String
  // A rule matches when the document amount falls in [minAmount, maxAmount).
  minAmount Decimal  @default(0)
  maxAmount Decimal?

  approverRoleId String
  sequence       Int     @default(1)
  blocksPosting  Boolean @default(true)
  isActive       Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests ApprovalRequest[]

  @@unique([orgId, docType, name])
  @@index([accountId, orgId, docType, isActive])
}

model ApprovalRequest {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  docType  String
  docId    String
  ruleId   String
  sequence Int    @default(1)

  amount Decimal @default(0)
  status String  @default("PENDING") // PENDING | APPROVED | REJECTED

  requestedByUserId String
  decidedByUserId   String?
  decidedAt         DateTime?
  comment           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([accountId, orgId, docType, docId])
  @@index([accountId, orgId, status])
}

// ----------------------------
// User permissions — document-level restrictions, generalised
// ----------------------------
// Branch and warehouse access already have dedicated tables because they are
// also the tenancy boundary. This covers everything else: restrict a user to
// certain customers, vendors, cost centres, and so on.
model UserPermission {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  userId    String

  entityType String // CUSTOMER | VENDOR | COST_CENTRE | ITEM_GROUP
  entityId   String
  label      String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([accountId, orgId, userId, entityType, entityId])
  @@index([accountId, orgId, userId, entityType])
}

// ----------------------------
// Feature toggles, per organisation
// ----------------------------
model FeatureSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  key     String
  enabled Boolean

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, key])
  @@index([accountId, orgId])
}

// ----------------------------
// Parties — customers and vendors
// ----------------------------
// One table for both: an entity is frequently a customer and a vendor at once,
// and splitting them duplicates GSTIN, address and contact handling.
model Party {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  // null = shared across branches, which is the usual case for a customer list
  branchId  String?

  partyType String // CUSTOMER | VENDOR | BOTH
  code      String?
  name      String
  legalName String?

  gstin               String?
  gstRegistrationType String  @default("UNREGISTERED")
  pan                 String?
  placeOfSupplyState  String?

  email         String?
  phone         String?
  contactPerson String?

  billingLine1   String?
  billingLine2   String?
  billingCity    String?
  billingState   String?
  billingPincode String?
  billingCountry String? @default("India")

  shippingSameAsBilling Boolean @default(true)
  shippingLine1         String?
  shippingLine2         String?
  shippingCity          String?
  shippingState         String?
  shippingPincode       String?
  shippingCountry       String?

  // Drives the due date on documents so it cannot be bypassed in the browser.
  paymentTermDays Int      @default(0)
  paymentTermName String?
  creditLimit     Decimal?

  openingBalance     Decimal @default(0)
  openingBalanceType String  @default("DR") // DR | CR

  notes    String?
  isActive Boolean @default(true)

  // Migration identity, so a re-run maps to the same row.
  sourceSystem String?
  sourceKey    String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, partyType, name])
  @@unique([orgId, sourceSystem, sourceKey])
  @@index([accountId, orgId, partyType, isActive])
  @@index([accountId, orgId, gstin])
}

// ----------------------------
// Sessions and auth hardening
// ----------------------------
// A refresh token is stored only as a hash: a leaked database row must not be
// usable as a credential.
model Session {
  id        String @id @default(cuid())
  accountId String
  userId    String

  refreshTokenHash String  @unique
  userAgent        String?
  ip               String?

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  // Set when this session is rotated, so a replayed old token is detectable.
  replacedBySessionId String?

  @@index([accountId, userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  accountId String
  userId    String

  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Security-relevant authentication events, kept separately from the business
/// audit log so a retention policy can differ.
model AuthEvent {
  id        String  @id @default(cuid())
  accountId String?
  userId    String?

  email     String?
  eventType String // LOGIN_SUCCESS | LOGIN_FAILED | LOCKED_OUT | LOGOUT |
  // PASSWORD_RESET_REQUESTED | PASSWORD_RESET | TOKEN_REFRESHED | SESSION_REVOKED
  ip        String?
  userAgent String?
  detail    String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, eventType, createdAt])
}

// ----------------------------
// Email: settings, outbox, verification
// ----------------------------
model EmailSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String @unique

  // SYSTEM uses the platform's own transport; SMTP uses the org's own server.
  provider String @default("SYSTEM")

  host        String?
  port        Int?
  secure      Boolean @default(true)
  username    String?
  // AES-256-GCM ciphertext. Never returned by the API.
  passwordEnc String?

  fromName  String?
  fromEmail String?
  replyTo   String?

  verifiedAt DateTime?
  lastError  String?

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId])
}

/// Every message the product tries to send, with its outcome. Doubles as the
/// retry queue and the "did the customer actually receive it" answer.
model EmailOutbox {
  id        String  @id @default(cuid())
  accountId String?
  orgId     String?

  templateKey String
  toEmail     String
  toName      String?
  subject     String
  bodyText    String
  bodyHtml    String?

  status    String    @default("QUEUED") // QUEUED | SENT | FAILED | SUPPRESSED
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  relatedType String?
  relatedId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, orgId, status])
  @@index([templateKey, createdAt])
}

model EmailVerificationToken {
  id        String @id @default(cuid())
  accountId String
  userId    String

  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Which notifications an organisation wants, per event.
model NotificationSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  eventKey        String
  enabled         Boolean @default(true)
  /// Extra addresses that receive this event, beyond its natural recipient.
  extraRecipients String?

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, eventKey])
  @@index([accountId, orgId])
}
